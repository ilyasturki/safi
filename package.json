{
    "name": "safi",
    "type": "module",
    "version": "0.1.1",
    "private": false,
    "description": "A minimalist, self hosted text editor for markdown files. Safi provides a clean, mobile-friendly interface focused on your content.",
    "license": "MIT",
    "scripts": {
        "dev": "nuxt dev",
        "build": "nuxt build",
        "postinstall": "nuxt prepare",
        "start": "bun --env-file=.env .output/server/index.mjs",
        "typecheck": "nuxt prepare && vue-tsc -b --noEmit",
        "format": "prettier --ignore-unknown --write .",
        "format:check": "prettier --ignore-unknown --check .",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "clear": "rm -rf .nuxt/ .output/ node_modules/ dist/"
    },
    "dependencies": {
        "@codemirror/autocomplete": "^6.20.2",
        "@codemirror/commands": "^6.10.3",
        "@codemirror/lang-css": "^6.3.1",
        "@codemirror/lang-html": "^6.4.11",
        "@codemirror/lang-javascript": "^6.2.5",
        "@codemirror/lang-json": "^6.0.2",
        "@codemirror/lang-markdown": "^6.5.0",
        "@codemirror/lang-python": "^6.2.1",
        "@codemirror/language": "^6.12.3",
        "@codemirror/search": "^6.7.0",
        "@codemirror/state": "^6.6.0",
        "@codemirror/view": "^6.43.0",
        "@fontsource/ibm-plex-mono": "^5.2.7",
        "@lezer/highlight": "^1.2.3",
        "@lezer/markdown": "^1.6.3",
        "@nuxt/icon": "2.2.2",
        "@replit/codemirror-vim": "^6.3.0",
        "@tailwindcss/vite": "^4.3.0",
        "@vueuse/core": "^14.3.0",
        "h3": "^1.15.4",
        "nuxt": "^4.4.6",
        "tailwindcss": "^4.3.0",
        "thememirror": "^2.0.1",
        "vue": "^3.5.34",
        "vue-router": "^5.0.7"
    },
    "devDependencies": {
        "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
        "@types/bun": "^1.3.14",
        "oxlint": "^1.66.0",
        "oxlint-tsgolint": "^0.23.0",
        "prettier": "^3.8.3",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "typescript": "^6.0.3",
        "vue-tsc": "^3.3.2"
    }
}
