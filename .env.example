# Global config directory (optional)
# Where the vault list (vaults.json), preferences, and keybindings are stored.
# Vaults themselves are registered from the app — there is no vaults-path env var.
# Defaults to the XDG config dir ($XDG_CONFIG_HOME/safi, or ~/.config/safi) when unset.
# Example: NUXT_CONFIG_PATH=/home/user/.config/safi
NUXT_CONFIG_PATH=

# Mistral API key for AI text suggestions (uses Codestral FIM endpoint)
# Get yours at https://console.mistral.ai/
NUXT_MISTRAL_API_KEY=
