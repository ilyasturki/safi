# Workspace Configuration
# Path to the directory containing your markdown files
# All file operations will be restricted to this directory and its subdirectories
# Example: NUXT_WORKSPACE_PATH=/home/user/documents/notes
NUXT_WORKSPACE_PATH=

# Mistral API key for AI text suggestions (uses Codestral FIM endpoint)
# Get yours at https://console.mistral.ai/
NUXT_MISTRAL_API_KEY=
