# Vaults Configuration
# Parent directory holding one subfolder per vault.
# Each top-level non-hidden subfolder of this path is auto-discovered as a vault.
# Example: NUXT_VAULTS_PATH=/home/user/documents/vaults
NUXT_VAULTS_PATH=

# Global config directory
# Where preferences.json and keybindings.json are stored (shared across all vaults).
# Example: NUXT_CONFIG_PATH=/home/user/.config/safi
NUXT_CONFIG_PATH=

# Mistral API key for AI text suggestions (uses Codestral FIM endpoint)
# Get yours at https://console.mistral.ai/
NUXT_MISTRAL_API_KEY=
